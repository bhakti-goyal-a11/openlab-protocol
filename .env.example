# OPENLAB TRUSTX Environment Configuration

# Database: SQLite by default; seamlessly PostgreSQL-compatible
DATABASE_URL=sqlite:///./openlab_trustx.db

# Cryptographic Token Signing
SECRET_KEY=openlab-trustx-ultra-secure-jwt-secret-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Port
PORT=8000
